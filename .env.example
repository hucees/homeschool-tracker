# Copy this file to .env.local after creating the Supabase project.
# Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only. Never prefix this with NEXT_PUBLIC_ and never commit a real value.
# Used only for instructor-managed student Auth accounts.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
